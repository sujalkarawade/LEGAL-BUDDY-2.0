# Legal Buddy Connect — map tiles (everything prefixed VITE_ is PUBLIC; never put a secret key here)
# Defaults use the public OpenStreetMap tile server, which is for development/demo only:
# no SLA, visible attribution required, no heavy or bulk use
# (https://operations.osmfoundation.org/policies/tiles/). For production use a commercial or
# self-hosted tile provider and set its URL + attribution below.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
VITE_MAP_MAX_ZOOM=19
