# ─────────────────────────────────────────────────────────────────────────────
# Legal Buddy Connect — add these to server/.env (all optional; defaults shown)
# ─────────────────────────────────────────────────────────────────────────────

# Private storage for lawyer credentials and profile photos. Kept OUTSIDE UPLOAD_DIR so
# `npm run clean:uploads` never deletes verification evidence. Never serve this folder statically.
CONNECT_PRIVATE_DIR=./private_uploads/connect
CONNECT_CREDENTIAL_MAX_MB=5
CONNECT_PHOTO_MAX_MB=2

# Geocoding (city / locality / PIN code search). All calls go through the backend.
# Default provider is the public OSM Nominatim server — development/demo only. Its policy
# (https://operations.osmfoundation.org/policies/nominatim/) requires: max 1 request/second for
# the whole app, an identifying User-Agent, caching, no autocomplete, and an off switch.
# Location search stays DISABLED until GEOCODER_USER_AGENT is set (users can still use
# "Use my location" or pick a point on the map).
GEOCODER_ENABLED=true
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=LegalBuddy/2.0 (final-year project; contact: you@example.com)
GEOCODER_COUNTRY_CODES=in
GEOCODER_MIN_INTERVAL_MS=1100
GEOCODER_TIMEOUT_MS=8000
