# Legal Buddy Environment Configuration

PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://your_user:your_password@localhost:5432/legal_buddy?schema=public"

# Authentication Secrets
JWT_SECRET="replace-with-a-long-random-secret"
# Production rejects this placeholder and the historical development secret.
# Use a unique random secret; changing an existing secret invalidates signed sessions.
JWT_EXPIRES_IN="7d"

# AI Provider Configuration
# Supported providers: "groq", "gemini", "openai", "auto" (picks configured key), or "heuristic" (local engine)
AI_PROVIDER="auto"
# AI_PROVIDER="heuristic" disables external generation AND embeddings even when keys exist.
LLM_API_KEY=""
GROQ_API_KEY=""
LLM_MODEL="meta-llama/llama-3.3-70b-instruct"
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""

# Retrieval-augmented chat
# When GEMINI_API_KEY is configured, the server stores multilingual Gemini embeddings
# in the existing PostgreSQL document_chunks table. Without it, chat uses exact-term retrieval.
# 768 dimensions; index records model ID, dimensions and retrieval schema version.
# After changing the model, retry each document to rebuild compatible vectors.
RAG_EMBEDDING_MODEL="gemini-embedding-001"
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=180
RAG_RETRIEVAL_LIMIT=5

# Local OCR (PaddleOCR) - runs fully offline, NO credentials required.
# The existing PP-OCRv5 Devanagari model targets mixed English/Marathi; verify quality on your scans.
# Requires Python + the packages in server/ocr/requirements.txt (see server/ocr/README.md).
# OCR_LANG: recognition model - 'devanagari' covers English + Marathi (+ Hindi).
# OCR_PYTHON: path/interpreter name for Python (default: python).
# OCR_DPI: rendering resolution for scanned pages (default: 200).
# OCR_MAX_PAGES: max scanned pages to OCR per document (default: 300).
# OCR_TIMEOUT_MS: hard timeout for the OCR worker in ms (default: 900000 = 15 min).
OCR_LANG="devanagari"
OCR_PYTHON="python"
OCR_DPI=200
OCR_MAX_PAGES=300
OCR_TIMEOUT_MS=900000

# Document Upload Settings
MAX_FILE_SIZE_MB=15
UPLOAD_DIR="./uploads"

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"
